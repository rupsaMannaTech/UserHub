<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add new User Id</title>
</head>
<body>
    <form method="POST" action="/user">
        <input type="Id" name="id" placeholder="Enter userId"/></br></br>
        <input type="Name" name="username" placeholder="Enter userName"/></br></br>
        <input type="Email" name="email" placeholder="Enter userEmail"/></br></br>
        <input type="Password" name="password" placeholder="Enter password"/></br></br>
        <button>Submit</button>
    </form>
</body>
</html>