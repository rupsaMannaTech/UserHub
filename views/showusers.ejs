<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <style>
    table,tr,th,td{
        border: 1px solid black;
    }
</style>
</head>
<body>
    <table>
        <tr>
            <th>userId</th>
            <th>userName</th>
            <th>email</th>
            <th>edit</th>
            <th>delete</th>
        </tr>
    
    <% for(user of users){ %>
        <tr>
            <td> <%= user.id %></td>
            <td> <%= user.username %></td>
            <td> <%= user.email %></td>
            <td>
            <form method="GET" action="/user/<%= user.id %>/edit">
                <button>Edit username</button>
            </form>
            </td>
            <td>
            <form method="GET" action="/user/<%= user.id %>/delete">
            
                <button>Delete username</button>
            </form>
            </td>
        </tr>
        <% } %>
        </table>
        <form method="GET" action="/user/<&=user.id %>/add">
        <button style="margin-left: 845px;background-color: rgb(104, 245, 104);">Add newUserId</button>
        </form>
</body>
</html>